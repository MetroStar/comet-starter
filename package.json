{
  "name": "comet-starter",
  "homepage": "https://metrostar.github.io/comet-starter/",
  "private": true,
  "version": "1.0.0",
  "description": "React and TypeScript starter app, pre-configured with the Comet component library and other tools.",
  "license": "Apache-2.0",
  "keywords": [
    "uswds",
    "react",
    "components",
    "comet",
    "open source"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "npx eslint src/ --fix --config eslint.config.js",
    "lint:ci": "npx eslint src/ --config eslint.config.js",
    "format": "npx prettier src --write",
    "format:ci": "npx prettier src --check",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "e2e": "npx playwright test --ui",
    "e2e:ci": "npx playwright test",
    "a11y": "unlighthouse --config-file .unlighthouse.config.ts --site http://localhost:5173",
    "a11y:ci": "unlighthouse --config-file .unlighthouse.config.ts --headless",
    "predeploy": "vite build --base=/comet-starter/",
    "deploy": "gh-pages -d dist",
    "precommit": "npm run build && npm run lint && npm run format"
  },
  "dependencies": {
    "@metrostar/comet-data-viz": "1.2.2",
    "@metrostar/comet-extras": "1.9.0",
    "@metrostar/comet-uswds": "3.9.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "5.100.14",
    "axios": "1.16.1",
    "axios-mock-adapter": "2.1.0",
    "jotai": "2.20.0",
    "oidc-client-ts": "^3.5.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "7.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.27",
    "axe-core": "4.12.0",
    "dotenv": "^17.3.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "puppeteer": "^25.1.0",
    "sass": "1.100.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "unlighthouse": "0.17.9",
    "vite": "^8.0.7",
    "vite-plugin-environment": "1.1.3",
    "vitest": "^4.0.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.24.0"
  }
}
